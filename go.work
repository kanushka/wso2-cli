go 1.25.0

// The workspace composes the unpublished SDK and reference module during local
// development. Committed replace directives are prohibited in every go.mod;
// see docs/plans/first-cli-vertical-slice.md section 4.
use (
	.
	./examples/reference-module
	./sdk
)

// The reference module requires the public SDK by version, which is how it will
// depend on a published release. That version does not exist yet, so the
// workspace resolves it from this checkout while building the module graph.
//
// This belongs here rather than in a go.mod precisely because it is local
// composition: it disappears the moment an SDK version is published, and it
// cannot travel with the reference module to another repository.
// The replacement names the exact placeholder version, because a workspace
// module may not be replaced at all versions.
replace github.com/wso2/wso2-cli/sdk v0.0.0 => ./sdk
