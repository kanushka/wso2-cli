# One deployment, described once.
#
# Copy this to a file the live targets can read and fill in the two or three
# values that are yours:
#
#     cp test/smoke/env.example test/smoke/.env
#     make smoke-login
#
# `make smoke-login` and `make empirical-asgardeo` source test/smoke/.env when
# it exists. Keep one file per deployment and name the one you want:
#
#     make smoke-login SMOKE_ENV=test/smoke/asgardeo.env
#
# Nothing parses this file. It is an ordinary shell fragment, so it works just
# as well on its own, which is what to do when running the tests directly
# rather than through make:
#
#     . test/smoke/asgardeo.env
#     go test -tags smoke -count=1 -v -timeout 30m ./test/smoke/ -run TestLoginSmoke
#
# Sourcing overwrites whatever the calling shell already exported, so switching
# between deployments does not need a fresh terminal — the file you name always
# wins. `make` prints which file it read.
#
# *.env is ignored by git, and nothing secret belongs in one regardless. None of
# the variables below is a credential: a public client has no secret, and the CI
# path reads its client secret from the environment variable a context names, so
# that the secret stays in job memory. Naming that variable here would put it on
# disk and defeat the point.
#
# See RUNNING.md in this directory for what every variable means, and
# docs/guides/login.md for how to register the application they describe.

# --- Asgardeo ------------------------------------------------------------

export WSO2_SMOKE_ISSUER='https://api.asgardeo.io/t/<organization>/oauth2/token'
export WSO2_SMOKE_CLIENT_ID='<client id>'
export WSO2_SMOKE_SCOPE='reference:status:read reference:status:write'

# The audience is the client ID, and that is not a mistake in this file.
#
# Asgardeo binds a JWT access token's `aud` claim to the client ID and exposes
# no setting that changes it — not even the Audience field on the application's
# Protocol tab, which belongs to the ID token. The API resource identifier whose
# scopes the token carries never appears in `aud` at all, so naming it here
# costs a browser sign-in and ends in auth.narrowing_unavailable.
#
# Written as a reference rather than as the same string twice, so the two cannot
# drift apart. Section 2.5 of the walkthrough explains what this costs: the
# broker's audience check still proves a token was minted for this client, but
# on Asgardeo it cannot tell one product's tokens from another's.
export WSO2_SMOKE_AUDIENCE="$WSO2_SMOKE_CLIENT_ID"

# --- Identity Server 7.x, locally ----------------------------------------
#
# Delete the block above and uncomment this one. Here AUDIENCE is the API
# resource identifier: Identity Server puts every entry of the application's
# audience list into the access token beside the client ID, so the broker can
# tell one product's tokens from another's. Section 3.5 records the difference.
#
# Confirm the issuer rather than assuming it. A deployment with a port offset
# answers on 9444 or higher, and the shell checks the discovery document against
# the issuer it was fetched from, so a value that is close but not exact fails
# at login:
#
#     curl -sk https://localhost:9443/oauth2/token/.well-known/openid-configuration
#
# This deployment also has to be trusted by the operating system before login
# can reach it at all. See section 3.6 of the walkthrough.

# export WSO2_SMOKE_ISSUER='https://localhost:9443/oauth2/token'
# export WSO2_SMOKE_CLIENT_ID='<client id>'
# export WSO2_SMOKE_AUDIENCE='reference-status'
# export WSO2_SMOKE_SCOPE='reference:status:read reference:status:write'
# export WSO2_SMOKE_IDENTITY_TYPE=onprem

# --- Optional ------------------------------------------------------------

# Nothing below is needed for `make smoke-login-device`. It describes the same
# deployment from the same variables above and differs only in the kind the
# context document declares, which the run sets for itself. What it does need is
# the Device Code grant enabled on the application named by WSO2_SMOKE_CLIENT_ID.

# The identity's home organization. Left unset, the smoke context names none.
# export WSO2_SMOKE_TENANT='<organization>'

# The product endpoint recorded on the identity. Defaults to the issuer's origin.
# export WSO2_SMOKE_ENDPOINT='https://api.example.com'

# The loopback port the any-port experiment binds. Must be outside 10425-10428.
# export WSO2_SMOKE_UNREGISTERED_PORT=16000

# How long an experiment waits at the browser. Does not reach `make smoke-login`,
# which signs in through `wso2 login` and carries the shell's own deadline.
# export WSO2_SMOKE_DEADLINE=3m
