{
  "schemaVersion": 1,
  "namespace": "apim",
  "title": "API Platform",
  "compatibility": {
    "shell": ">=0.1.0 <2.0.0",
    "protocolVersions": [3]
  },
  "capabilities": {
    "authAudiences": ["api-management", "api-gateway", "api-invocation"],
    "authScopes": ["ap:gateway:read", "ap:project:create", "ap:project:delete", "ap:project:read", "ap:rest_api:create", "ap:rest_api:delete", "ap:rest_api:deployment:read", "ap:rest_api:read"],
    "product": {
      "audience": "resource",
      "scopes": ["ap:gateway:read", "ap:project:create", "ap:project:delete", "ap:project:read", "ap:rest_api:create", "ap:rest_api:delete", "ap:rest_api:deployment:read", "ap:rest_api:read"],
      "grant": "exchange",
      "gateway": {
        "audience": "resource"
      },
      "invocation": {
        "audience": "resource"
      }
    }
  }
}
